# Create smartstock_db and a MySQL user, then fill in local credentials.
# Generate a persistent key with: python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=mysql+pymysql://YOUR_MYSQL_USER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3306/smartstock_db?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-value
# Keep false for local HTTP. Set true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Optional override; default is ml/artifacts/demand_model.joblib
# MODEL_PATH=ml/artifacts/demand_model.joblib
